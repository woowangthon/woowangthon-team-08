# Google Gemini API 키 (챗봇/요약 기능에 필요)
# https://aistudio.google.com 에서 발급 후 .env.local 파일에 넣으세요.
GOOGLE_GENERATIVE_AI_API_KEY=

# Supabase Auth (로그인/회원가입)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 정부24 공공서비스 API 인증키 (서버 전용)
GOV24_SERVICE_KEY=

# 네이버 지도 (상담기관 찾기 지도)
# 네이버 클라우드 콘솔 > Maps 애플리케이션의 Client ID. 사이트 주소(localhost:3000 등)를 등록해야 해요.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=